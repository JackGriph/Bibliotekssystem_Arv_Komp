@page "/members"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Medlemmar</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Medlemmar</h1>
        <p class="page-subtitle">Registrerade medlemmar och deras lånestatus.</p>
    </div>
    <a href="/members/new" class="action-btn">Registrera medlem</a>
</div>

@if (members == null)
{
    <p><em>Laddar medlemmar...</em></p>
}
else if (!members.Any())
{
    <p>Inga medlemmar hittades.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Medlems-ID</th>
                    <th>Namn</th>
                    <th>E-post</th>
                    <th>Medlem sedan</th>
                    <th>Aktiva lån</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in PagedMembers)
                {
                    <tr>
                        <td>@m.MemberId</td>
                        <td>@m.Name</td>
                        <td>@m.Email</td>
                        <td>@m.MemberSince.ToString("yyyy-MM-dd")</td>
                        <td>
                            <span class="badge @(m.ActiveLoans > 0 ? "bg-warning" : "bg-secondary")">
                                @m.ActiveLoans
                            </span>
                        </td>
                        <td>
                            <a href="members/@m.Id" class="action-btn-sm">Detaljer</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">&laquo;</button>
                </li>
                @for (int i = 1; i <= TotalPages; i++)
                {
                    var p = i;
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(p)">@p</button>
                    </li>
                }
                <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">&raquo;</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private List<MemberDto>? members;
    private int currentPage = 1;
    private const int PageSize = 10;

    private int TotalPages => members == null || members.Count == 0 ? 1 : (int)Math.Ceiling(members.Count / (double)PageSize);
    private List<MemberDto> PagedMembers => members?.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        members = await Http.GetFromJsonAsync<List<MemberDto>>("api/members");
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
            currentPage = page;
    }
}
